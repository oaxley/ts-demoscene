extends layout.pug

block styles
    link(rel="stylesheet" type="text/css" href="/css/effect.css")

block credits
    if artist
        | Image by
        a(href=artist.link class="artist") #{artist.name}

    if website
        | on
        a(href=website.link class="website") #{website.name}

    .back-line
        a.back(href="/#" + name) &#10094;&#10094; back to the effects

block scripts
    script(src=bundle)
