{
    "name": "ts-demoscene",
    "version": "1.0.0",
    "description": "Oldskool demoscene effects in Typescript",
    "main": "public/js/express.bundle.js",
    "author": "slegrand <ut5svsxgc@relay.firefox.com>",
    "license": "Apache-2.0",
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "express": "^4.17.1",
        "pug": "^3.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^4.17.13",
        "@types/node": "^22.20.5",
        "@types/pngjs": "^6.0.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "jpeg-js": "^0.4.4",
        "pngjs": "^7.0.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:prod": "node scripts/build.mjs --prod",
        "watch": "node scripts/build.mjs --watch",
        "dev": "node scripts/build.mjs --watch --serve",
        "start": "node public/js/express.bundle.js",
        "clean": "node -e \"require('fs').rmSync('public', {recursive: true, force: true})\"",
        "typecheck": "tsc --noEmit -p .",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:update": "vitest run -u"
    }
}
